# Keep images stable across all deployment topologies.
#
# In the current image layout, RUN_MODE=etcd and RUN_MODE=standard/master/slave
# are supported by the same image. If etcd is later split into a dedicated
# image, only ETCD_IMAGE and compose files should change; topology logic stays
# outside the image.
OPENGAUSS_IMAGE=opengauss-ha:5.0.3_arm
ETCD_IMAGE=opengauss-ha:5.0.3_arm
