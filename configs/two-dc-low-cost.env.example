# A primary / B standby with A-preferred quorum, 3 physical machines.
#
# Node A1: etcd-a1 + openGauss/Patroni master preferred
# Node A2: etcd-a2 + openGauss/Patroni standby
# Node B1: etcd-b1 + openGauss/Patroni standby
#
# This topology does not automatically fail over when the whole A site is lost.

OPENGAUSS_IMAGE=opengauss-ha:5.0.3_arm
ETCD_IMAGE=opengauss-ha:5.0.3_arm

ETCD_A1=etcd-a1:10.0.1.10
ETCD_B1=etcd-a2:10.0.1.11
ETCD_C1=etcd-b1:10.0.2.10

MASTER=master:10.0.1.10:leader
SLAVE01=slave01:10.0.1.11:standby
SLAVE02=slave02:10.0.2.10:standby

GAUSS_USER=gauss
GAUSS_PASSWORD=SecurePass123
GAUSS_DATABASE=test

LOOP_WAIT=10
RETRY_TIMEOUT=30
TTL=60
SYNCHRONOUS_MODE=false
MAXIMUM_LAG_ON_FAILOVER=104857600

MAX_CONNECTIONS=1000
WAL_LEVEL=logical
